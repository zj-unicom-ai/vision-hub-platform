# ============================================================
# Vision Hub Platform - Docker Compose example configuration
# Copy this file to .env before running docker compose.
# All default passwords are for local evaluation only. Change them
# immediately after the first deployment.
# ============================================================

# ---- Web console login (seeded by schema.sql) ----
# username: unicom  password: ZJ_Unicom

# ---- External ports ----
FRONTEND_PORT=80
WEB_EXTERNAL_PORT=18080
MEDIA_EXTERNAL_PORT=18081
MYSQL_EXTERNAL_PORT=3306
REDIS_EXTERNAL_PORT=6379
KAFKA_EXTERNAL_PORT=9092
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=ZJ_Unicom
MYSQL_DATABASE=vision_hub

# ---- Redis ----
REDIS_PASSWORD=ZJ_Unicom

# ---- MinIO (root user is also the access key) ----
MINIO_ROOT_USER=ZJ_Unicom
MINIO_ROOT_PASSWORD=ZJ_Unicom
MINIO_BUCKET=vision-hub
# Browser-facing file prefix. nginx proxies /minio/ to the MinIO container.
MINIO_CDN=/minio

# ---- Shared secret for internal web<->media calls ----
INTERNAL_SECRET=ZJ_Unicom

# ---- JWT signing secret (login tokens). Any string works; changing it
#      invalidates all issued tokens (users must log in again). ----
JWT_SECRET=ZJ_Unicom

# ---- Kafka cluster id (UUID: 22-char URL-safe base64, Keep unchanged after first startup) ----
KAFKA_CLUSTER_ID=WkpfVW5pY29tAAAAAAAAAA

# ---- JVM options ----
WEB_JAVA_OPTS=-XX:+UseG1GC -Xms1g -Xmx1g
MEDIA_JAVA_OPTS=-XX:+UseG1GC -Xms512m -Xmx512m
